# R build/dev artifacts
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.lintr$
^cran-comments\.md$
^CRAN-SUBMISSION$
^doc$
^Meta$
# Shared scaffold layer: everything below is dev tooling, not package content,
# and would otherwise trip "non-standard files/directories" in R CMD check.
^\.gitlab-ci\.yml$
# The CI job library. It has to live under the project directory because that
# is the only thing GitLab's cache can carry, which puts it inside the package
# root while R CMD build runs -- so it is ignored here rather than moved.
^\.rlib$
^\.editorconfig$
^\.env$
^\.env\.example$
^\.gitattributes$
^\.gitignore$
# In a git worktree .git is a regular file (a gitdir: pointer), which R CMD build
# does not exclude the way it does a .git directory; it would ship as a hidden file.
^\.git$
# Agent worktrees live under .claude/worktrees/; keep them out of a tarball
# built from the main clone.
^\.claude$
^\.pre-commit-config\.yaml$
^\.fp$
^_scratch$
^docs$
^CLAUDE\.md$
^AGENTS\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^CHANGELOG\.md$
^\.DS_Store$
^bench$
^data-raw$
# The citation gate ported from seor (design/adr/0001 and 0002 there).
# Not part of the installable package; without this, --as-cran reports it
# as a non-standard top-level directory.
^scripts$
# Release build scratch. Without this, R CMD build copies it into the
# tarball and the check reports a top-level-files NOTE -- the one that
# data-raw/verify.sh's own header says cannot happen (RADD-mmsfavww).
^tmp$
# pkgdown config and its build output (destination: public in _pkgdown.yml).
^_pkgdown\.yml$
^public$
# Citation metadata for the forge and Zenodo (RADD-dxzfcbjx), not package
# content. In the tarball, CITATION.cff is a non-standard top-level file and
# .zenodo.json a hidden one, and --as-cran reports both.
^CITATION\.cff$
^\.zenodo\.json$
# Fleet-standard files (SEOR-lavybtkr): forge, policy and metadata files, not
# package content. LICENSE.md is the full MIT text for the forge's license
# detector; the package ships the two-line LICENSE stub CRAN expects.
^LICENSE\.md$
^CODE_OF_CONDUCT\.md$
^ARCHITECTURE\.md$
^SECURITY-INSIGHTS\.yml$
^codemeta\.json$
^\.gitlab$
^README\.Rmd$
