# R build/dev artifacts
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.lintr$
^cran-comments\.md$
^CRAN-SUBMISSION$
^doc$
^Meta$
# Shared scaffold layer: everything below is dev tooling, not package content,
# and would otherwise trip "non-standard files/directories" in R CMD check.
^\.gitlab-ci\.yml$
# The CI job library. It has to live under the project directory because that
# is the only thing GitLab's cache can carry, which puts it inside the package
# root while R CMD build runs -- so it is ignored here rather than moved.
^\.rlib$
^\.editorconfig$
^\.env$
^\.env\.example$
^\.gitattributes$
^\.gitignore$
^\.pre-commit-config\.yaml$
^\.fp$
^FP_AGENTS\.md$
^_scratch$
^docs$
^CLAUDE\.md$
^AGENTS\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^CHANGELOG\.md$
^\.DS_Store$
^bench$
^data-raw$
# The citation gate ported from seor (design/adr/0001 and 0002 there).
# Not part of the installable package; without this, --as-cran reports it
# as a non-standard top-level directory.
^scripts$
