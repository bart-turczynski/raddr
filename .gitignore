.env.*
!.env.example
*.log
.DS_Store

_scratch/

# Heavy artifacts — never commit (a big blob bloats .git history even after deletion).
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.faiss
*.npy
*.npz
vectors/

.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
*.Rcheck/
*.tar.gz
# The former GitLab CI job library (R_LIBS_USER), which no job writes since
# the fleet-ci migration.
.rlib/
src/*.o
src/*.so
src/*.dll
vignettes/*.html
vignettes/*.pdf
doc/
Meta/
tests/testthat/_snaps/

# Fiberplane local issue tracking
.fp/

# Release build scratch (data-raw/build-release.sh). Listed deliberately:
# the two files in it happen to match *.tar.gz and *.log, so the directory
# was kept out of git status by coincidence rather than intent
# (RADD-mmsfavww).
tmp/

# pkgdown build output (see _pkgdown.yml), and the public/ the pages job
# moves it to; .fleet-lib/ is the library t2-sanitizers installs into.
site/
public/
.fleet-lib/
